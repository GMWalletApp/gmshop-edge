{
  "name": "gmshop-edge",
  "version": "1.0.3",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "cloudflare": {
    "label": "GMShop Edge",
    "products": [
      "Workers",
      "D1",
      "KV",
      "R2",
      "Queues"
    ],
    "categories": [
      "storage"
    ],
    "publish": false,
    "bindings": {
      "DB": {
        "description": "D1 stores authentication, catalog, orders, inventory, entitlements, automation, notifications, and system data. Remote migrations run during deployment."
      },
      "FILES": {
        "description": "Private R2 storage for product media, downloads, automation artifacts, and exports."
      },
      "CACHE": {
        "description": "KV storage for short-lived RBAC and public configuration caches; security rate limits remain D1-authoritative."
      },
      "COMMERCE_QUEUE": {
        "description": "Queue for durable delivery, automation, notification, and refund work."
      },
      "EMAIL": {
        "description": "Cloudflare Send Email binding used by the credential-free cloudflare_email notification provider."
      }
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "defaultIgnores": false
  },
  "scripts": {
    "dev": "bun run db:migrate:local && vite dev --port 3000",
    "generate-paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie custom-system-default baseLocale",
    "build": "bun run scripts/build.ts",
    "build:bun": "bun --bun vite build --config vite.bun.config.ts",
    "start:bun": "bun .output/server/index.mjs",
    "bundle:report": "bun run scripts/bundle-report.ts",
    "preview": "vite preview",
    "predeploy": "bun run scripts/build.ts --remote",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "commitlint": "commitlint",
    "hooks:install": "lefthook install",
    "release": "semantic-release",
    "test": "bun run test:vitest && bun run test:bun-runtime",
    "test:vitest": "vitest run --exclude tests/unit/server/node-data-operations.test.ts --exclude tests/unit/server/node-runtime-adapters.test.ts --exclude tests/unit/server/node-server-runtime.test.ts",
    "test:bun-runtime": "bun test tests/unit/server/node-data-operations.test.ts tests/unit/server/node-runtime-adapters.test.ts tests/unit/server/node-server-runtime.test.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "wrangler d1 migrations apply gmshop-edge --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "bun run scripts/seed-acceptance.ts --local --with-r2",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "data": "bun scripts/data.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@gsap/react": "^2.1.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@monaco-editor/react": "^4.7.0",
    "@noble/hashes": "^2.4.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/monaco": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "^9.1.2",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "^0.11.1",
    "@tma.js/sdk": "^3.3.0",
    "@visulima/email": "^2.1.7",
    "better-auth": "^1.7.6",
    "better-auth-telegram": "1.5.0",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.6",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.0",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "^1.60.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types-no-globals": "^1.4.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.14",
    "miniflare": "^4.20260730.0",
    "nitro": "^3.0.260610-beta",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0",
    "yaml": "^2.9.1"
  }
}
